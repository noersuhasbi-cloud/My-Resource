rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Helper Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        ((request.auth.token.email == "nsuhasbi.riskap@gmail.com" || request.auth.token.email == "abonglagi@gmail.com") && request.auth.token.email_verified == true)
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUser(data) {
      return data.keys().hasAll(['userId', 'name', 'email', 'memberTier', 'grocePoints'])
        && data.userId is string && data.userId.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.email is string && data.email.size() <= 100
        && (data.memberTier in ['Silver Member', 'Gold Member', 'Platinum Member'])
        && data.grocePoints is number && data.grocePoints >= 0;
    }

    function isValidAddress(data) {
      return data.keys().hasAll(['addressId', 'label', 'recipient', 'phone', 'addressLine', 'city'])
        && data.label is string && data.label.size() <= 50
        && data.recipient is string && data.recipient.size() <= 100
        && data.addressLine is string && data.addressLine.size() <= 300
        && data.city is string && data.city.size() <= 50;
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['orderId', 'customerName', 'deliveryMethod', 'total', 'paymentMethod', 'paymentStatus', 'status'])
        && data.orderId is string && data.orderId.size() <= 50
        && data.customerName is string && data.customerName.size() <= 100
        && (!('customerEmail' in data) || (data.customerEmail is string && data.customerEmail.size() <= 100))
        && (data.deliveryMethod in ['instant', 'scheduled', 'pickup'])
        && (data.paymentMethod in ['qris', 'bank_transfer', 'card'])
        && (data.paymentStatus in ['unpaid', 'paid'])
        && (data.status in ['placed', 'paid', 'packing', 'in_transit', 'ready_for_pickup', 'delivered', 'completed', 'cancelled'])
        && data.total is number && data.total >= 0;
    }

    function isValidPosReceipt(data) {
      return data.keys().hasAll(['receiptId', 'storeId', 'cashierId', 'paymentMethod', 'currency', 'grandTotalIDR', 'timestamp'])
        && data.receiptId is string && data.receiptId.size() <= 64
        && data.storeId is string && data.storeId.size() <= 64
        && data.cashierId is string && data.cashierId.size() <= 64
        && (data.paymentMethod in ['CASH', 'QRIS', 'DEBIT_CREDIT', 'BANK_TRANSFER', 'SPLIT'])
        && (data.currency in ['IDR', 'USD', 'EUR', 'AUD'])
        && data.grandTotalIDR is number && data.grandTotalIDR >= 0
        && data.timestamp is string && data.timestamp.size() <= 64;
    }

    // Users Collection & Subcollections
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidUser(incoming());
      allow update: if (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidUser(incoming());
      allow delete: if isAdmin() && isValidId(userId);

      match /addresses/{addressId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if (isOwner(userId) || isAdmin()) && isValidId(addressId) && isValidAddress(incoming());
        allow delete: if (isOwner(userId) || isAdmin()) && isValidId(addressId);
      }
    }

    // Orders Collection
    match /orders/{orderId} {
      allow get: if true;
      allow list: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isValidId(orderId) && isValidOrder(incoming());
      allow update: if isValidId(orderId) && isValidOrder(incoming());
      allow delete: if isAdmin() && isValidId(orderId);
    }

    // POS Receipts Collection
    match /pos_receipts/{receiptId} {
      allow get: if true;
      allow list: if isSignedIn() || isAdmin();
      allow create: if isValidId(receiptId) && isValidPosReceipt(incoming());
      allow update: if isAdmin() && isValidId(receiptId) && isValidPosReceipt(incoming());
      allow delete: if isAdmin() && isValidId(receiptId);
    }

    // Products Collection (Allows public reading of catalog and direct Firestore storage of Base64 images)
    match /products/{productId} {
      allow read: if true;
      allow create, update: if isSignedIn() || isAdmin();
      allow delete: if isAdmin() && isValidId(productId);
    }

    // Connection Healthcheck Document
    match /test/{docId} {
      allow read: if true;
    }
  }
}
